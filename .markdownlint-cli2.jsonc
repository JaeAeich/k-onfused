{
  "config": {
    "default": true,
    // prose is wrapped at 100 by prettier; tables, code and long links may run over
    "MD013": { "line_length": 100, "tables": false, "code_blocks": false, "headings": false },
    "MD033": false,
    "MD041": false,
  },
  "globs": ["**/*.md"],
  // generated by `npm run results` (wide tables, one line per trial)
  "ignores": ["node_modules", "results/*/README.md", "results/*/details.md"],
}
