# Backend: claude-code (default; uses your Claude Code login / Max subscription, no key needed) or openrouter
BACKEND=claude-code
# Claude Code model alias or id for the worker: haiku | sonnet | opus
CC_MODEL=sonnet

# Only needed for BACKEND=openrouter
OPENROUTER_API_KEY=sk-or-...
QDRANT_URL=http://localhost:6333
# OpenRouter model id for the worker (BACKEND=openrouter)
WORKER_MODEL=anthropic/claude-sonnet-4.5

# Optional: export one OpenTelemetry trace per trial to Arize Phoenix (docker compose up -d phoenix, UI on :6006)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
